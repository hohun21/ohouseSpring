<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ohouse.web.mapper.auth.MemberSignupMapper">

	<!-- public MemberVO getMember(@Param("id") String id) -->
	<select id="getMember" resultType="com.ohouse.web.domain.member.MemberVO">
		SELECT * FROM member WHERE id=#{id}
	</select>

	<!-- public int insert(MemberVO memberVO) -->
	<insert id="insert">
		INSERT INTO member( member_id, id, password, name, reg_date, rank )
		VALUES( seq_member.NEXTVAL, #{id}, #{password}, #{name}, SYSDATE, 'NORMAL' )
	</insert>
	
	<!-- public int insertAuthority(@Param("id") String id) -->
	<insert id="insertAuthority">
    	INSERT INTO member_authorities (username, authority)
    	VALUES ( #{id}, 'ROLE_USER' )
	</insert>

</mapper>